# ========================================================
# Environment Variables Template for Portfolio
# ========================================================

# Supabase Public Client (Browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-api-key

# Supabase Server-Only Client (Used by Server Actions for secure writes)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Rate Limiting & Anti-Spam Security Salt (Random string for SHA-256 IP hashing)
RATE_LIMIT_SALT=replace-with-a-secure-random-salt-string-for-ip-hashing

# Optional GitHub profile for external integration
NEXT_PUBLIC_GITHUB_USERNAME=BroAegg
